<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Fermer</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Retour</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">Activé</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Désactivé</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Activer</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Désactiver</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Activer « %1$s »</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Désactiver « %1$s »</string>
    <string name="not_now">Plus tard</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Changer</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Changer de navigateur</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Nettoyez vos liens</string>
    <string name="welcome_body">De nombreux liens contiennent un traceur qui indique aux sites qui les a partagés et ce que vous avez touché. Bugged protège votre vie privée en le supprimant. Le lien ouvre toujours la même page.</string>
    <string name="welcome_offline">Fonctionne hors connexion. Bugged n’a pas accès à Internet, donc rien ne quitte votre téléphone.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged a besoin de l’Accessibilité pour détecter et nettoyer les liens que vous copiez.</string>
    <string name="welcome_action">Configurer</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Choisissez quoi nettoyer</string>
    <string name="home_copy">Nettoyage des liens copiés</string>
    <string name="home_open">Nettoyage des liens ouverts</string>
    <string name="home_both">Nettoyage des liens copiés et ouverts</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s lien nettoyé</item>
        <item quantity="many">%1$s de liens nettoyés</item>
        <item quantity="other">%1$s liens nettoyés</item>
    </plurals>

    <string name="copy_title">Liens copiés</string>
    <string name="copy_description">Copiez un lien dans n’importe quelle application et collez-le nettoyé.</string>
    <string name="open_title">Liens ouverts</string>
    <string name="open_description">Touchez un lien dans n’importe quelle application et il s’ouvre nettoyé dans votre navigateur.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">S’ouvre dans %1$s</string>

    <string name="copy_sheet_title">Nettoyer les liens copiés</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged utilise l’Accessibilité pour détecter les liens que vous copiez et les nettoyer quand ils contiennent un traceur.</string>
    <string name="copy_sheet_access">L’application regarde uniquement les boutons « Copier » que vous touchez et le texte que vous copiez. Elle ne lit jamais rien d’autre sur votre écran.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">Dans Paramètres, touchez %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Activez %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Utiliser %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Si Paramètres affiche « Paramètre restreint », ouvrez Infos sur l’appli de Bugged, touchez les 3 points, puis %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Autoriser les paramètres restreints</string>
    <string name="copy_sheet_action">Ouvrir Paramètres</string>

    <string name="open_sheet_title">Nettoyer les liens ouverts</string>
    <string name="open_sheet_what">Faites de Bugged votre appli de navigateur par défaut et choisissez le navigateur qui ouvre les liens nettoyés. Bugged nettoie chaque lien que vous touchez et le transmet.</string>
    <string name="open_sheet_never">Bugged ne charge jamais la page lui-même.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Les liens nettoyés s’ouvrent dans %1$s</string>
    <string name="open_sheet_action">Définir par défaut</string>
    <string name="browser_none">Aucun navigateur trouvé</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Choisir un navigateur</string>

    <string name="about">À propos</string>
    <string name="about_version">Version de l’application</string>
    <string name="about_rate">Noter sur Google Play</string>
    <string name="about_feedback">Commentaires et idées</string>
    <string name="about_feedback_note">Signalez un problème ou proposez une fonctionnalité. Je lis tous les e-mails.</string>
    <string name="about_feedback_subject">Commentaires et idées</string>
    <string name="about_author">Conçu et développé par @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Copier les informations sur l’application et l’appareil</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Copié</string>
    <string name="privacy_policy">Politique de confidentialité</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Supprime les traceurs des liens copiés</string>
    <string name="service_description">Détecte quand vous copiez un lien et en supprime les traceurs. Pour détecter une copie, le service repère les boutons « Copier » que vous touchez et l’aperçu du presse-papiers. Bugged ne conserve rien de ce qu’il voit et n’a pas accès à Internet.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Lien nettoyé</string>
</resources>
