<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Schließen</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Zurück</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">An</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Aus</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Aktivieren</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Deaktivieren</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">%1$s aktivieren</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">%1$s deaktivieren</string>
    <string name="not_now">Nicht jetzt</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Ändern</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Browser ändern</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Bereinige deine Links</string>
    <string name="welcome_body">Viele Links enthalten einen Tracker, der Websites verrät, wer sie geteilt hat und worauf du getippt hast. Bugged schützt deine Privatsphäre, indem es ihn entfernt. Der Link öffnet weiterhin dieselbe Seite.</string>
    <string name="welcome_offline">Funktioniert offline. Bugged hat keinen Internetzugriff, deshalb verlässt nichts dein Smartphone.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged benötigt die Bedienungshilfen, um kopierte Links zu erkennen und zu bereinigen.</string>
    <string name="welcome_action">Einrichten</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Wähle, was bereinigt wird</string>
    <string name="home_copy">Kopierte Links werden bereinigt</string>
    <string name="home_open">Geöffnete Links werden bereinigt</string>
    <string name="home_both">Kopierte und geöffnete Links werden bereinigt</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s Link bereinigt</item>
        <item quantity="other">%1$s Links bereinigt</item>
    </plurals>

    <string name="copy_title">Kopierte Links</string>
    <string name="copy_description">Kopiere einen Link in einer beliebigen App und füge ihn bereinigt ein.</string>
    <string name="open_title">Geöffnete Links</string>
    <string name="open_description">Tippe in einer beliebigen App auf einen Link, und er öffnet sich bereinigt in deinem Browser.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Wird in %1$s geöffnet</string>

    <string name="copy_sheet_title">Kopierte Links bereinigen</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged nutzt die Bedienungshilfen, um kopierte Links zu erkennen und sie zu bereinigen, wenn sie einen Tracker enthalten.</string>
    <string name="copy_sheet_access">Die App achtet nur auf „Kopieren“-Schaltflächen, auf die du tippst, und auf den Text, den du kopierst. Alles andere auf deinem Bildschirm liest sie nie.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">Tippe in den Einstellungen auf %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Aktiviere %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">%1$s verwenden</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Wenn in den Einstellungen „Eingeschränkte Einstellung“ erscheint, öffne die App-Info von Bugged, tippe auf die drei Punkte und dann auf %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Eingeschränkte Einstellungen zulassen</string>
    <string name="copy_sheet_action">Einstellungen öffnen</string>

    <string name="open_sheet_title">Geöffnete Links bereinigen</string>
    <string name="open_sheet_what">Lege Bugged als Standard-Browser-App fest und wähle den Browser, der die bereinigten Links öffnet. Bugged bereinigt jeden Link, auf den du tippst, und gibt ihn weiter.</string>
    <string name="open_sheet_never">Bugged lädt die Seite nie selbst.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Bereinigte Links werden in %1$s geöffnet</string>
    <string name="open_sheet_action">Als Standard festlegen</string>
    <string name="browser_none">Kein Browser gefunden</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Browser auswählen</string>

    <string name="about">Über die App</string>
    <string name="about_version">App-Version</string>
    <string name="about_rate">Bei Google Play bewerten</string>
    <string name="about_feedback">Feedback &amp; Ideen</string>
    <string name="about_feedback_note">Melde einen Fehler oder schlage eine Funktion vor. Ich lese jede E-Mail.</string>
    <string name="about_feedback_subject">Feedback und Ideen</string>
    <string name="about_author">Gestaltet und entwickelt von @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">App- und Geräteinfos kopieren</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Kopiert</string>
    <string name="privacy_policy">Datenschutzerklärung</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Entfernt Tracker aus kopierten Links</string>
    <string name="service_description">Erkennt, wenn du einen Link kopierst, und entfernt seine Tracker. Dazu achtet die App auf „Kopieren“-Schaltflächen, auf die du tippst, und auf die Vorschau der Zwischenablage. Bugged speichert nichts von dem, was es sieht, und hat keinen Internetzugriff.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Bereinigter Link</string>
</resources>
