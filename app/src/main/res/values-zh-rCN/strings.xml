<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">关闭</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">返回</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">开</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">关</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">开启</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">关闭</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">开启“%1$s”</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">关闭“%1$s”</string>
    <string name="not_now">以后再说</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">更改</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">更改浏览器</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">清理你的链接</string>
    <string name="welcome_body">很多链接都带有跟踪标记，会告诉网站是谁分享了链接、你点了什么。Bugged 会移除这些标记，保护你的隐私。链接打开的仍是同一个页面。</string>
    <string name="welcome_offline">离线运行。Bugged 无法联网，任何内容都不会离开你的手机。</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged 需要使用无障碍功能，才能检测并清理你复制的链接。</string>
    <string name="welcome_action">开始设置</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">选择要清理的链接</string>
    <string name="home_copy">正在清理复制的链接</string>
    <string name="home_open">正在清理打开的链接</string>
    <string name="home_both">正在清理复制和打开的链接</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="other">已清理 %1$s 个链接</item>
    </plurals>

    <string name="copy_title">复制的链接</string>
    <string name="copy_description">在任意应用中复制链接，粘贴时已清理干净。</string>
    <string name="open_title">打开的链接</string>
    <string name="open_description">在任意应用中点按链接，浏览器打开的就是清理后的链接。</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">在 %1$s 中打开</string>

    <string name="copy_sheet_title">清理复制的链接</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged 通过无障碍功能检测你复制的链接，在链接含有跟踪标记时将其清理。</string>
    <string name="copy_sheet_access">本应用只会查看你点按的“复制”按钮和你复制的文字，绝不会读取屏幕上的其他内容。</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">在“设置”中点按 %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">开启%1$s开关</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">使用“%1$s”</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">如果“设置”中显示“受限制的设置”，请打开 Bugged 的“应用信息”，点按三个点图标，然后点按%1$s。</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">允许受限制的设置</string>
    <string name="copy_sheet_action">打开设置</string>

    <string name="open_sheet_title">清理打开的链接</string>
    <string name="open_sheet_what">将 Bugged 设为默认浏览器应用，并选择用来打开清理后链接的浏览器。Bugged 会清理你点按的每个链接，再将其转交给该浏览器。</string>
    <string name="open_sheet_never">Bugged 自身从不加载网页。</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">清理后的链接将在 %1$s 中打开</string>
    <string name="open_sheet_action">设为默认应用</string>
    <string name="browser_none">未找到浏览器</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">选择浏览器</string>

    <string name="about">关于</string>
    <string name="about_version">应用版本</string>
    <string name="about_rate">在 Google Play 上评分</string>
    <string name="about_feedback">反馈与建议</string>
    <string name="about_feedback_note">报告问题或提出功能建议。每封邮件我都会看。</string>
    <string name="about_feedback_subject">反馈与建议</string>
    <string name="about_author">由 @vadiole 设计和开发</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">复制应用和设备信息</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">已复制</string>
    <string name="privacy_policy">隐私政策</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">移除复制的链接中的跟踪标记</string>
    <string name="service_description">在你复制链接时察觉并移除其中的跟踪标记。为了察觉复制操作，它会留意你点按的“复制”按钮和剪贴板预览。Bugged 不会保留看到的任何内容，也无法联网。</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">清理后的链接</string>
</resources>
