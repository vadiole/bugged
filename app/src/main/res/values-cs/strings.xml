<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Zavřít</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Zpět</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">Zapnuto</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Vypnuto</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Zapnout</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Vypnout</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Zapnout %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Vypnout %1$s</string>
    <string name="not_now">Teď ne</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Změnit</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Změnit prohlížeč</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Vyčistěte si odkazy</string>
    <string name="welcome_body">Mnoho odkazů nese sledovací značku, která webům prozradí, kdo je sdílel a na co jste klepli. Bugged ji odstřihne a chrání tak vaše soukromí. Odkaz otevře stejnou stránku.</string>
    <string name="welcome_offline">Funguje offline. Bugged nemá přístup k internetu, takže nic neopustí váš telefon.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Aby Bugged mohl rozpoznat a vyčistit odkazy, které zkopírujete, potřebuje Přístupnost.</string>
    <string name="welcome_action">Nastavit</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Vyberte, co čistit</string>
    <string name="home_copy">Čistí se odkazy, které kopírujete</string>
    <string name="home_open">Čistí se odkazy, které otevíráte</string>
    <string name="home_both">Čistí se odkazy, které kopírujete a otevíráte</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s vyčištěný odkaz</item>
        <item quantity="few">%1$s vyčištěné odkazy</item>
        <item quantity="many">%1$s vyčištěného odkazu</item>
        <item quantity="other">%1$s vyčištěných odkazů</item>
    </plurals>

    <string name="copy_title">Kopírované odkazy</string>
    <string name="copy_description">Zkopírujte odkaz v libovolné aplikaci a vložte ho čistý.</string>
    <string name="open_title">Otevírané odkazy</string>
    <string name="open_description">Klepněte na odkaz v libovolné aplikaci a otevře se čistý ve vašem prohlížeči.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Otevírá se v prohlížeči %1$s</string>

    <string name="copy_sheet_title">Čistit kopírované odkazy</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged používá Přístupnost k rozpoznání odkazů, které zkopírujete, aby je mohl vyčistit, když obsahují sledovací značku.</string>
    <string name="copy_sheet_access">Aplikace vidí jen tlačítka Kopírovat, na která klepnete, a text, který zkopírujete. Nic jiného na obrazovce nikdy nečte.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">V Nastavení klepněte na %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Zapněte přepínač %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Používat aplikaci %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Pokud Nastavení zobrazí „Omezené nastavení“, otevřete pro Bugged stránku O aplikaci, klepněte na tři tečky a pak na %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Povolit omezená nastavení</string>
    <string name="copy_sheet_action">Otevřít Nastavení</string>

    <string name="open_sheet_title">Čistit otevírané odkazy</string>
    <string name="open_sheet_what">Nastavte Bugged jako výchozí prohlížeč a vyberte prohlížeč, ve kterém se čisté odkazy otevřou. Bugged vyčistí každý odkaz, na který klepnete, a předá ho dál.</string>
    <string name="open_sheet_never">Bugged stránku sám nikdy nenačítá.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Čisté odkazy se otevírají v prohlížeči %1$s</string>
    <string name="open_sheet_action">Změnit na výchozí</string>
    <string name="browser_none">Nebyl nalezen žádný prohlížeč</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Vyberte prohlížeč</string>

    <string name="about">O aplikaci</string>
    <string name="about_version">Verze aplikace</string>
    <string name="about_rate">Ohodnotit na Google Play</string>
    <string name="about_feedback">Zpětná vazba a nápady</string>
    <string name="about_feedback_note">Nahlaste chybu nebo navrhněte novou funkci. Čtu každý e-mail.</string>
    <string name="about_feedback_subject">Zpětná vazba a nápady</string>
    <string name="about_author">Navrhl a vytvořil @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Zkopírovat informace o aplikaci a zařízení</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Zkopírováno</string>
    <string name="privacy_policy">Zásady ochrany soukromí</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Odstraňuje sledovací značky ze zkopírovaných odkazů</string>
    <string name="service_description">Pozná, když zkopírujete odkaz, a odstraní z něj sledovací značky. Kopírování pozná podle tlačítek Kopírovat, na která klepnete, a podle náhledu schránky. Bugged si nic z toho, co vidí, neukládá a nemá přístup k internetu.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Čistý odkaz</string>
</resources>
