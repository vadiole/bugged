<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Lukk</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Tilbake</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">På</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Av</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Slå på</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Slå av</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Slå på %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Slå av %1$s</string>
    <string name="not_now">Ikke nå</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Endre</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Endre nettleser</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Rens lenkene dine</string>
    <string name="welcome_body">Mange lenker har en sporingskode som forteller nettsteder hvem som delte dem og hva du trykket på. Bugged beskytter personvernet ditt ved å fjerne den. Lenken åpner den samme siden.</string>
    <string name="welcome_offline">Fungerer uten nett. Bugged har ikke internettilgang, så ingenting forlater telefonen din.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged må slås på under Tilgjengelighet for å oppdage og rense lenker du kopierer.</string>
    <string name="welcome_action">Sett opp</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Velg hva som skal renses</string>
    <string name="home_copy">Renser lenker du kopierer</string>
    <string name="home_open">Renser lenker du åpner</string>
    <string name="home_both">Renser lenker du kopierer og åpner</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s lenke renset</item>
        <item quantity="other">%1$s lenker renset</item>
    </plurals>

    <string name="copy_title">Lenker du kopierer</string>
    <string name="copy_description">Kopier en lenke i en hvilken som helst app, og lim den inn ren.</string>
    <string name="open_title">Lenker du åpner</string>
    <string name="open_description">Trykk på en lenke i en hvilken som helst app, så åpnes den ren i nettleseren din.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Åpnes i %1$s</string>

    <string name="copy_sheet_title">Rens lenker du kopierer</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged bruker Tilgjengelighet til å oppdage lenker du kopierer, slik at den kan rense dem når de inneholder en sporingskode.</string>
    <string name="copy_sheet_access">Appen ser bare på Kopier-knapper du trykker på, og teksten du kopierer. Den leser aldri noe annet på skjermen.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">Trykk på %1$s i Innstillinger</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Slå på %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Bruk %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Hvis Innstillinger viser «Begrenset innstilling», åpner du Info om appen for Bugged, trykker på de tre prikkene og deretter på %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Tillat begrensede innstillinger</string>
    <string name="copy_sheet_action">Åpne Innstillinger</string>

    <string name="open_sheet_title">Rens lenker du åpner</string>
    <string name="open_sheet_what">Gjør Bugged til standard nettleserapp, og velg nettleseren som skal åpne de rene lenkene. Bugged renser hver lenke du trykker på, og sender den videre.</string>
    <string name="open_sheet_never">Bugged laster aldri inn selve siden.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Rene lenker åpnes i %1$s</string>
    <string name="open_sheet_action">Angi som standard</string>
    <string name="browser_none">Fant ingen nettleser</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Velg en nettleser</string>

    <string name="about">Om</string>
    <string name="about_version">Appversjon</string>
    <string name="about_rate">Vurder på Google Play</string>
    <string name="about_feedback">Tilbakemelding og ideer</string>
    <string name="about_feedback_note">Rapporter en feil eller foreslå en funksjon. Jeg leser hver e-post.</string>
    <string name="about_feedback_subject">Tilbakemelding og ideer</string>
    <string name="about_author">Designet og utviklet av @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Kopier app- og enhetsinformasjon</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Kopiert</string>
    <string name="privacy_policy">Personvernerklæring</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Fjerner sporingskoder fra kopierte lenker</string>
    <string name="service_description">Merker når du kopierer en lenke, og fjerner sporingskodene. For å merke at du kopierer, ser den etter Kopier-knapper du trykker på, og forhåndsvisningen av utklippstavlen. Bugged lagrer ingenting den ser, og har ikke internettilgang.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Ren lenke</string>
</resources>
