<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">閉じる</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">戻る</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">オン</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">オフ</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">オンにする</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">オフにする</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">「%1$s」をオンにする</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">「%1$s」をオフにする</string>
    <string name="not_now">後で</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">変更</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">ブラウザを変更</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">リンクをきれいに</string>
    <string name="welcome_body">多くのリンクには、誰が共有したか、何をタップしたかをサイトに伝える追跡タグが付いています。Bugged はこのタグを取り除いて、プライバシーを守ります。開くページは変わりません。</string>
    <string name="welcome_offline">オフラインで動作します。Bugged はインターネットにアクセスしないため、スマホの外に送られるものは何もありません。</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">コピーしたリンクを検出してきれいにするには、Bugged にユーザー補助が必要です。</string>
    <string name="welcome_action">セットアップ</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">きれいにするリンクを選択</string>
    <string name="home_copy">コピーしたリンクをきれいにしています</string>
    <string name="home_open">開くリンクをきれいにしています</string>
    <string name="home_both">コピーしたリンクと開くリンクをきれいにしています</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="other">%1$s 件のリンクをきれいにしました</item>
    </plurals>

    <string name="copy_title">コピーしたリンク</string>
    <string name="copy_description">どのアプリでもリンクをコピーすると、きれいな状態で貼り付けられます。</string>
    <string name="open_title">開くリンク</string>
    <string name="open_description">どのアプリでもリンクをタップすると、きれいな状態でブラウザで開きます。</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">%1$s で開きます</string>

    <string name="copy_sheet_title">コピーしたリンクをきれいにする</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged はユーザー補助を使ってコピーしたリンクを検出し、追跡タグが含まれている場合はきれいにします。</string>
    <string name="copy_sheet_access">このアプリが確認するのは、タップした「コピー」ボタンとコピーしたテキストだけです。画面上のそれ以外の内容を読み取ることはありません。</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">設定で %1$s をタップします</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">「%1$s」をオンにします</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">%1$sを使用</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">設定で「制限付き設定」と表示された場合は、Bugged のアプリ情報を開き、3つの点をタップしてから「%1$s」をタップしてください。</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">制限付き設定を許可</string>
    <string name="copy_sheet_action">設定を開く</string>

    <string name="open_sheet_title">開くリンクをきれいにする</string>
    <string name="open_sheet_what">Bugged をデフォルトのブラウザアプリに設定し、きれいなリンクを開くブラウザを選んでください。タップしたリンクはすべて Bugged がきれいにしてから、そのブラウザに渡します。</string>
    <string name="open_sheet_never">Bugged がページ自体を読み込むことはありません。</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">きれいなリンクは %1$s で開きます</string>
    <string name="open_sheet_action">デフォルトに設定</string>
    <string name="browser_none">ブラウザが見つかりません</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">ブラウザを選択</string>

    <string name="about">このアプリについて</string>
    <string name="about_version">アプリのバージョン</string>
    <string name="about_rate">Google Play で評価</string>
    <string name="about_feedback">フィードバック・アイデア</string>
    <string name="about_feedback_note">不具合の報告や機能の提案をお寄せください。メールはすべて読んでいます。</string>
    <string name="about_feedback_subject">フィードバック・アイデア</string>
    <string name="about_author">デザイン・開発：@vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">アプリと端末の情報をコピー</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">コピーしました</string>
    <string name="privacy_policy">プライバシーポリシー</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">コピーしたリンクから追跡タグを取り除きます</string>
    <string name="service_description">リンクのコピーを検出して、追跡タグを取り除きます。コピーを検出するために、タップした「コピー」ボタンとクリップボードのプレビューを確認します。Bugged は確認した内容を一切保存せず、インターネットにもアクセスしません。</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">きれいなリンク</string>
</resources>
