<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Cerrar</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Atrás</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">Activado</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Desactivado</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Activar</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Desactivar</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Activar %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Desactivar %1$s</string>
    <string name="not_now">Ahora no</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Cambiar</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Cambiar navegador</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Limpia tus enlaces</string>
    <string name="welcome_body">Muchos enlaces llevan un rastreador que indica a las webs quién los ha compartido y qué has tocado. Bugged protege tu privacidad quitándolo. El enlace sigue abriendo la misma página.</string>
    <string name="welcome_offline">Funciona sin conexión. Bugged no tiene acceso a internet, así que nada sale de tu teléfono.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged necesita usar Accesibilidad para detectar y limpiar los enlaces que copias.</string>
    <string name="welcome_action">Configurar</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Elige qué limpiar</string>
    <string name="home_copy">Limpiando los enlaces que copias</string>
    <string name="home_open">Limpiando los enlaces que abres</string>
    <string name="home_both">Limpiando los enlaces que copias y abres</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s enlace limpiado</item>
        <item quantity="many">%1$s enlaces limpiados</item>
        <item quantity="other">%1$s enlaces limpiados</item>
    </plurals>

    <string name="copy_title">Enlaces que copias</string>
    <string name="copy_description">Copia un enlace en cualquier app y pégalo limpio.</string>
    <string name="open_title">Enlaces que abres</string>
    <string name="open_description">Toca un enlace en cualquier app y se abrirá limpio en tu navegador.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Se abre en %1$s</string>

    <string name="copy_sheet_title">Limpiar los enlaces que copias</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged usa Accesibilidad para detectar los enlaces que copias y así limpiarlos cuando llevan un rastreador.</string>
    <string name="copy_sheet_access">La app solo se fija en los botones Copiar que tocas y en el texto que copias. Nunca lee nada más de tu pantalla.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">En Ajustes, toca %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Activa %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Usar %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Si Ajustes muestra «Ajuste restringido», abre la Información de aplicación de Bugged, toca los 3 puntos y luego %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Permitir ajustes restringidos</string>
    <string name="copy_sheet_action">Abrir Ajustes</string>

    <string name="open_sheet_title">Limpiar los enlaces que abres</string>
    <string name="open_sheet_what">Haz que Bugged sea tu aplicación de navegador predeterminada y elige el navegador que abrirá los enlaces limpios. Bugged limpia cada enlace que tocas y se lo pasa a ese navegador.</string>
    <string name="open_sheet_never">Bugged nunca llega a cargar la página.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Los enlaces limpios se abren en %1$s</string>
    <string name="open_sheet_action">Establecer como predeterminado</string>
    <string name="browser_none">No se ha encontrado ningún navegador</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Elegir un navegador</string>

    <string name="about">Acerca de</string>
    <string name="about_version">Versión de la app</string>
    <string name="about_rate">Valorar en Google Play</string>
    <string name="about_feedback">Comentarios e ideas</string>
    <string name="about_feedback_note">Informa de un error o sugiere una función. Leo todos los correos.</string>
    <string name="about_feedback_subject">Comentarios e ideas</string>
    <string name="about_author">Diseñado y desarrollado por @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Copiar información de la app y del dispositivo</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Copiado</string>
    <string name="privacy_policy">Política de privacidad</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Quita los rastreadores de los enlaces copiados</string>
    <string name="service_description">Detecta cuando copias un enlace y le quita los rastreadores. Para detectar una copia, se fija en los botones Copiar que tocas y en la vista previa del portapapeles. Bugged no guarda nada de lo que ve y no tiene acceso a internet.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Enlace limpio</string>
</resources>
