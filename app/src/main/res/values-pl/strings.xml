<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Zamknij</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Wstecz</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">Włączone</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Wyłączone</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Włącz</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Wyłącz</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Włącz funkcję „%1$s”</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Wyłącz funkcję „%1$s”</string>
    <string name="not_now">Nie teraz</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Zmień</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Zmień przeglądarkę</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Oczyść swoje linki</string>
    <string name="welcome_body">Wiele linków zawiera znacznik, który mówi stronom, kto je udostępnił i co otwierasz. Bugged chroni Twoją prywatność, usuwając go. Link nadal otwiera tę samą stronę.</string>
    <string name="welcome_offline">Działa offline. Bugged nie ma dostępu do internetu, więc nic nie opuszcza telefonu.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged potrzebuje Ułatwień dostępu, aby wykrywać i oczyszczać kopiowane linki.</string>
    <string name="welcome_action">Skonfiguruj</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Wybierz, co oczyszczać</string>
    <string name="home_copy">Oczyszczanie kopiowanych linków</string>
    <string name="home_open">Oczyszczanie otwieranych linków</string>
    <string name="home_both">Oczyszczanie kopiowanych i otwieranych linków</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s oczyszczony link</item>
        <item quantity="few">%1$s oczyszczone linki</item>
        <item quantity="many">%1$s oczyszczonych linków</item>
        <item quantity="other">%1$s oczyszczonego linku</item>
    </plurals>

    <string name="copy_title">Kopiowane linki</string>
    <string name="copy_description">Skopiuj link w dowolnej aplikacji, a wkleisz oczyszczoną wersję.</string>
    <string name="open_title">Otwierane linki</string>
    <string name="open_description">Dotknij linku w dowolnej aplikacji, a otworzy się w przeglądarce już oczyszczony.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Otwierają się w przeglądarce %1$s</string>

    <string name="copy_sheet_title">Oczyszczaj kopiowane linki</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged korzysta z Ułatwień dostępu, aby wykrywać kopiowane linki i oczyszczać je, gdy zawierają znacznik śledzący.</string>
    <string name="copy_sheet_access">Aplikacja sprawdza tylko przyciski „Kopiuj”, których dotykasz, i kopiowany tekst. Nigdy nie odczytuje niczego innego na ekranie.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">W aplikacji Ustawienia dotknij %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Włącz przełącznik %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Włącz usługę %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Jeśli aplikacja Ustawienia pokaże komunikat „Ustawienia z ograniczonym dostępem”, otwórz Informacje o aplikacji Bugged, dotknij ikony z trzema kropkami i wybierz %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Zezwól na ustawienia z ograniczonym dostępem</string>
    <string name="copy_sheet_action">Otwórz Ustawienia</string>

    <string name="open_sheet_title">Oczyszczaj otwierane linki</string>
    <string name="open_sheet_what">Ustaw Bugged jako domyślną przeglądarkę i wybierz przeglądarkę, w której będą otwierać się oczyszczone linki. Bugged oczyszcza każdy link, którego dotkniesz, i przekazuje go dalej.</string>
    <string name="open_sheet_never">Bugged nigdy nie wczytuje strony samodzielnie.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Oczyszczone linki otwierają się w przeglądarce %1$s</string>
    <string name="open_sheet_action">Ustaw jako domyślną</string>
    <string name="browser_none">Nie znaleziono przeglądarki</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Wybierz przeglądarkę</string>

    <string name="about">O aplikacji</string>
    <string name="about_version">Wersja aplikacji</string>
    <string name="about_rate">Oceń w Google Play</string>
    <string name="about_feedback">Opinie i pomysły</string>
    <string name="about_feedback_note">Zgłoś błąd lub zaproponuj nową funkcję. Czytam każdą wiadomość.</string>
    <string name="about_feedback_subject">Opinie i pomysły</string>
    <string name="about_author">Zaprojektował i stworzył @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Kopiuj informacje o aplikacji i urządzeniu</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Skopiowano</string>
    <string name="privacy_policy">Polityka prywatności</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Usuwa znaczniki śledzące z kopiowanych linków</string>
    <string name="service_description">Wykrywa skopiowanie linku i usuwa z niego znaczniki śledzące. Aby to wykryć, sprawdza przyciski „Kopiuj”, których dotykasz, i podgląd schowka. Bugged nie zachowuje niczego, co widzi, i nie ma dostępu do internetu.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Oczyszczony link</string>
</resources>
