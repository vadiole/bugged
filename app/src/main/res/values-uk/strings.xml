<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Закрити</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Назад</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">Увімкнено</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Вимкнено</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Увімкнути</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Вимкнути</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Увімкнути: %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Вимкнути: %1$s</string>
    <string name="not_now">Не зараз</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Змінити</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Змінити браузер</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Очищайте посилання</string>
    <string name="welcome_body">Багато посилань містять мітку, яка повідомляє сайтам, хто ними поділився і що ви натиснули. Bugged відрізає її, щоб захистити вашу конфіденційність. Посилання відкриває ту саму сторінку.</string>
    <string name="welcome_offline">Працює офлайн. Bugged не має доступу до інтернету, тож ніщо не покидає ваш телефон.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged потрібна «Доступність», щоб виявляти й очищати посилання, які ви копіюєте.</string>
    <string name="welcome_action">Налаштувати</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Виберіть, що очищати</string>
    <string name="home_copy">Очищаються посилання, які ви копіюєте</string>
    <string name="home_open">Очищаються посилання, які ви відкриваєте</string>
    <string name="home_both">Очищаються посилання, які ви копіюєте й відкриваєте</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s посилання очищено</item>
        <item quantity="few">%1$s посилання очищено</item>
        <item quantity="many">%1$s посилань очищено</item>
        <item quantity="other">%1$s посилання очищено</item>
    </plurals>

    <string name="copy_title">Скопійовані посилання</string>
    <string name="copy_description">Скопіюйте посилання в будь-якому додатку й вставте його вже очищеним.</string>
    <string name="open_title">Відкриті посилання</string>
    <string name="open_description">Натисніть посилання в будь-якому додатку, і воно відкриється в браузері вже очищеним.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Відкривається в %1$s</string>

    <string name="copy_sheet_title">Очищайте посилання, які копіюєте</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged використовує «Доступність», щоб виявляти посилання, які ви копіюєте, і очищати їх, якщо в них є мітка відстеження.</string>
    <string name="copy_sheet_access">Додаток бачить лише кнопки «Копіювати», які ви натискаєте, і текст, який ви копіюєте. Він ніколи не читає нічого іншого на екрані.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">У налаштуваннях натисніть %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Увімкніть перемикач %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Використовувати %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Якщо в налаштуваннях з’явиться «Налаштування з обмеженнями», відкрийте для Bugged екран «Про додаток», натисніть три крапки, а потім %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Дозволити налаштування з обмеженнями</string>
    <string name="copy_sheet_action">Відкрити налаштування</string>

    <string name="open_sheet_title">Очищайте посилання, які відкриваєте</string>
    <string name="open_sheet_what">Зробіть Bugged вебпереглядачем за умовчанням і виберіть браузер, у якому відкриватимуться очищені посилання. Bugged очищає кожне посилання, яке ви натискаєте, і передає його далі.</string>
    <string name="open_sheet_never">Bugged ніколи не завантажує сторінку сам.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Очищені посилання відкриваються в %1$s</string>
    <string name="open_sheet_action">Вибрати за умовчанням</string>
    <string name="browser_none">Браузер не знайдено</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Виберіть браузер</string>

    <string name="about">Про додаток</string>
    <string name="about_version">Версія додатка</string>
    <string name="about_rate">Оцінити в Google Play</string>
    <string name="about_feedback">Відгуки та ідеї</string>
    <string name="about_feedback_note">Повідомте про помилку або запропонуйте нову функцію. Я читаю кожен лист.</string>
    <string name="about_feedback_subject">Відгуки та ідеї</string>
    <string name="about_author">Задизайнив і розробив @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Скопіювати дані про додаток і пристрій</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Скопійовано</string>
    <string name="privacy_policy">Політика конфіденційності</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Видаляє мітки відстеження зі скопійованих посилань</string>
    <string name="service_description">Помічає, коли ви копіюєте посилання, і видаляє з нього мітки відстеження. Щоб помітити копіювання, сервіс орієнтується на кнопки «Копіювати», які ви натискаєте, і на попередній перегляд буфера обміну. Bugged нічого не зберігає з того, що бачить, і не має доступу до інтернету.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Очищене посилання</string>
</resources>
