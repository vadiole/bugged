<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">बंद करें</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">वापस</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">चालू</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">बंद</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">चालू करें</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">बंद करें</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">%1$s चालू करें</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">%1$s बंद करें</string>
    <string name="not_now">अभी नहीं</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">बदलें</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">ब्राउज़र बदलें</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">अपने लिंक साफ़ करें</string>
    <string name="welcome_body">कई लिंक में एक ट्रैकर जुड़ा होता है, जो साइटों को बताता है कि लिंक किसने शेयर किया और आपने किस पर टैप किया। Bugged उसे हटाकर आपकी निजता बचाता है। लिंक से वही पेज खुलता है।</string>
    <string name="welcome_offline">बिना इंटरनेट के काम करता है। Bugged के पास इंटरनेट ऐक्सेस नहीं है, इसलिए कुछ भी आपके फ़ोन से बाहर नहीं जाता।</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">कॉपी किए गए लिंक पहचानने और साफ़ करने के लिए Bugged को सुलभता की ज़रूरत है।</string>
    <string name="welcome_action">सेट अप करें</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">चुनें कि क्या साफ़ करना है</string>
    <string name="home_copy">कॉपी किए गए लिंक साफ़ हो रहे हैं</string>
    <string name="home_open">खोले गए लिंक साफ़ हो रहे हैं</string>
    <string name="home_both">कॉपी किए गए और खोले गए लिंक साफ़ हो रहे हैं</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s लिंक साफ़ किया गया</item>
        <item quantity="other">%1$s लिंक साफ़ किए गए</item>
    </plurals>

    <string name="copy_title">कॉपी किए गए लिंक</string>
    <string name="copy_description">किसी भी ऐप में लिंक कॉपी करें और साफ़ लिंक पेस्ट करें।</string>
    <string name="open_title">खोले गए लिंक</string>
    <string name="open_description">किसी भी ऐप में लिंक पर टैप करें, वह आपके ब्राउज़र में साफ़ होकर खुलेगा।</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">%1$s में खुलता है</string>

    <string name="copy_sheet_title">कॉपी किए गए लिंक साफ़ करें</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged कॉपी किए गए लिंक पहचानने के लिए सुलभता का इस्तेमाल करता है, ताकि उनमें ट्रैकर होने पर वह उन्हें साफ़ कर सके।</string>
    <string name="copy_sheet_access">ऐप सिर्फ़ उन कॉपी बटन को देखता है जिन पर आप टैप करते हैं, और उस टेक्स्ट को जिसे आप कॉपी करते हैं। यह आपकी स्क्रीन पर और कुछ भी नहीं पढ़ता।</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">सेटिंग में, %1$s पर टैप करें</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">%1$s चालू करें</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">%1$s का इस्तेमाल करें</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">अगर सेटिंग में “इस सेटिंग पर पाबंदी लगाई गई है” दिखे, तो Bugged के लिए “ऐप्लिकेशन की जानकारी” खोलें, तीन बिंदुओं पर टैप करें, फिर %1$s पर टैप करें।</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">पाबंदी वाली सेटिंग को अनुमति दें</string>
    <string name="copy_sheet_action">सेटिंग खोलें</string>

    <string name="open_sheet_title">खोले गए लिंक साफ़ करें</string>
    <string name="open_sheet_what">Bugged को अपना डिफ़ॉल्ट ब्राउज़र ऐप्लिकेशन बनाएँ और वह ब्राउज़र चुनें जिसमें साफ़ लिंक खुलेंगे। Bugged आपके टैप किए हर लिंक को साफ़ करके आगे भेज देता है।</string>
    <string name="open_sheet_never">Bugged खुद कभी पेज लोड नहीं करता।</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">साफ़ लिंक %1$s में खुलते हैं</string>
    <string name="open_sheet_action">डिफ़ॉल्ट के रूप में सेट करें</string>
    <string name="browser_none">कोई ब्राउज़र नहीं मिला</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">ब्राउज़र चुनें</string>

    <string name="about">ऐप के बारे में</string>
    <string name="about_version">ऐप वर्शन</string>
    <string name="about_rate">Google Play पर रेटिंग दें</string>
    <string name="about_feedback">फ़ीडबैक और सुझाव</string>
    <string name="about_feedback_note">बग की रिपोर्ट करें या कोई नया फ़ीचर सुझाएँ। मैं हर ईमेल पढ़ता हूँ।</string>
    <string name="about_feedback_subject">फ़ीडबैक और सुझाव</string>
    <string name="about_author">डिज़ाइन और डेवलपमेंट: @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">ऐप और डिवाइस की जानकारी कॉपी करें</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">कॉपी हो गया</string>
    <string name="privacy_policy">निजता नीति</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">कॉपी किए गए लिंक से ट्रैकर हटाता है</string>
    <string name="service_description">जब आप कोई लिंक कॉपी करते हैं, तो यह उसे पहचानकर उसके ट्रैकर हटा देता है। कॉपी पहचानने के लिए यह उन कॉपी बटन को देखता है जिन पर आप टैप करते हैं, और क्लिपबोर्ड की झलक को। Bugged जो कुछ भी देखता है, उसमें से कुछ नहीं रखता और उसके पास इंटरनेट ऐक्सेस नहीं है।</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">साफ़ लिंक</string>
</resources>
