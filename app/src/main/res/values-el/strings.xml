<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Κλείσιμο</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Πίσω</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">Ενεργό</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Ανενεργό</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Ενεργοποίηση</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Απενεργοποίηση</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Ενεργοποίηση: %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Απενεργοποίηση: %1$s</string>
    <string name="not_now">Όχι τώρα</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Αλλαγή</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Αλλαγή προγράμματος περιήγησης</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Καθαρίστε τους συνδέσμους σας</string>
    <string name="welcome_body">Πολλοί σύνδεσμοι περιέχουν μια ετικέτα παρακολούθησης που λέει στους ιστότοπους ποιος κοινοποίησε τον σύνδεσμο και τι πατήσατε. Το Bugged προστατεύει το απόρρητό σας αφαιρώντας την. Ο σύνδεσμος ανοίγει την ίδια σελίδα.</string>
    <string name="welcome_offline">Λειτουργεί εκτός σύνδεσης. Το Bugged δεν έχει πρόσβαση στο διαδίκτυο, οπότε τίποτα δεν φεύγει από το τηλέφωνό σας.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Το Bugged χρειάζεται την Προσβασιμότητα για να εντοπίζει και να καθαρίζει τους συνδέσμους που αντιγράφετε.</string>
    <string name="welcome_action">Ρύθμιση</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Επιλέξτε τι θα καθαρίζεται</string>
    <string name="home_copy">Καθαρίζονται οι σύνδεσμοι που αντιγράφετε</string>
    <string name="home_open">Καθαρίζονται οι σύνδεσμοι που ανοίγετε</string>
    <string name="home_both">Καθαρίζονται οι σύνδεσμοι που αντιγράφετε και ανοίγετε</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s καθαρισμένος σύνδεσμος</item>
        <item quantity="other">%1$s καθαρισμένοι σύνδεσμοι</item>
    </plurals>

    <string name="copy_title">Σύνδεσμοι που αντιγράφετε</string>
    <string name="copy_description">Αντιγράψτε έναν σύνδεσμο σε οποιαδήποτε εφαρμογή και επικολλήστε τον καθαρό.</string>
    <string name="open_title">Σύνδεσμοι που ανοίγετε</string>
    <string name="open_description">Πατήστε έναν σύνδεσμο σε οποιαδήποτε εφαρμογή και θα ανοίξει καθαρός στο πρόγραμμα περιήγησής σας.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Ανοίγει στο %1$s</string>

    <string name="copy_sheet_title">Καθαρισμός συνδέσμων που αντιγράφετε</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Το Bugged χρησιμοποιεί την Προσβασιμότητα για να εντοπίζει τους συνδέσμους που αντιγράφετε, ώστε να τους καθαρίζει όταν περιέχουν ετικέτα παρακολούθησης.</string>
    <string name="copy_sheet_access">Η εφαρμογή βλέπει μόνο τα κουμπιά «Αντιγραφή» που πατάτε και το κείμενο που αντιγράφετε. Δεν διαβάζει ποτέ τίποτα άλλο στην οθόνη σας.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">Στις Ρυθμίσεις, πατήστε %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Ενεργοποιήστε την επιλογή %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Χρήση %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Αν οι Ρυθμίσεις εμφανίσουν «Περιορισμένη ρύθμιση», ανοίξτε τις Πληροφορίες εφαρμογής του Bugged, πατήστε τις 3 τελείες και μετά %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Επιτρέπονται περιορισμένες ρυθμίσεις</string>
    <string name="copy_sheet_action">Άνοιγμα Ρυθμίσεων</string>

    <string name="open_sheet_title">Καθαρισμός συνδέσμων που ανοίγετε</string>
    <string name="open_sheet_what">Ορίστε το Bugged ως προεπιλεγμένο πρόγραμμα περιήγησης και επιλέξτε το πρόγραμμα περιήγησης που θα ανοίγει τους καθαρούς συνδέσμους. Το Bugged καθαρίζει κάθε σύνδεσμο που πατάτε και τον προωθεί.</string>
    <string name="open_sheet_never">Το Bugged δεν φορτώνει ποτέ το ίδιο τη σελίδα.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Οι καθαροί σύνδεσμοι ανοίγουν στο %1$s</string>
    <string name="open_sheet_action">Προεπιλογή</string>
    <string name="browser_none">Δεν βρέθηκε πρόγραμμα περιήγησης</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Επιλογή προγράμματος περιήγησης</string>

    <string name="about">Σχετικά</string>
    <string name="about_version">Έκδοση εφαρμογής</string>
    <string name="about_rate">Βαθμολογήστε στο Google Play</string>
    <string name="about_feedback">Σχόλια και ιδέες</string>
    <string name="about_feedback_note">Αναφέρετε ένα σφάλμα ή προτείνετε μια λειτουργία. Διαβάζω κάθε email.</string>
    <string name="about_feedback_subject">Σχόλια και ιδέες</string>
    <string name="about_author">Σχεδίαση και ανάπτυξη: @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Αντιγραφή πληροφοριών εφαρμογής και συσκευής</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Αντιγράφηκε</string>
    <string name="privacy_policy">Πολιτική απορρήτου</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Αφαιρεί τις ετικέτες παρακολούθησης από αντιγραμμένους συνδέσμους</string>
    <string name="service_description">Αντιλαμβάνεται πότε αντιγράφετε έναν σύνδεσμο και αφαιρεί τις ετικέτες παρακολούθησής του. Για να αντιληφθεί την αντιγραφή, εντοπίζει τα κουμπιά «Αντιγραφή» που πατάτε και την προεπισκόπηση του προχείρου. Το Bugged δεν κρατά τίποτα από όσα βλέπει και δεν έχει πρόσβαση στο διαδίκτυο.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Καθαρός σύνδεσμος</string>
</resources>
