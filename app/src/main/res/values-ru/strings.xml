<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Закрыть</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Назад</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">Вкл.</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Выкл.</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Включить</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Выключить</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Включить «%1$s»</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Выключить «%1$s»</string>
    <string name="not_now">Не сейчас</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Изменить</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Изменить браузер</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Очищайте ссылки</string>
    <string name="welcome_body">Многие ссылки содержат метку, которая сообщает сайтам, кто ими поделился и на что вы нажали. Bugged удаляет эту метку и защищает вашу конфиденциальность. Ссылка ведёт на ту же страницу.</string>
    <string name="welcome_offline">Работает офлайн. У Bugged нет доступа к интернету, поэтому ничего не покидает ваш телефон.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged нужны «Спец. возможности», чтобы находить и очищать скопированные ссылки.</string>
    <string name="welcome_action">Настроить</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Выберите, что очищать</string>
    <string name="home_copy">Очистка копируемых ссылок</string>
    <string name="home_open">Очистка открываемых ссылок</string>
    <string name="home_both">Очистка копируемых и открываемых ссылок</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s ссылка очищена</item>
        <item quantity="few">%1$s ссылки очищены</item>
        <item quantity="many">%1$s ссылок очищено</item>
        <item quantity="other">%1$s ссылки очищено</item>
    </plurals>

    <string name="copy_title">Копируемые ссылки</string>
    <string name="copy_description">Скопируйте ссылку в любом приложении и вставьте её уже очищенной.</string>
    <string name="open_title">Открываемые ссылки</string>
    <string name="open_description">Нажмите на ссылку в любом приложении, и она откроется в браузере уже очищенной.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Открывается в %1$s</string>

    <string name="copy_sheet_title">Очистка копируемых ссылок</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged использует «Спец. возможности», чтобы находить скопированные ссылки и очищать их, если в них есть метка отслеживания.</string>
    <string name="copy_sheet_access">Приложение смотрит только на кнопки «Копировать», которые вы нажимаете, и на скопированный текст. Больше ничего на экране оно не читает.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">В Настройках нажмите %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Включите %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">%1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Если в Настройках появится сообщение «Настройки с ограниченным доступом», откройте экран «О приложении» для Bugged, нажмите на три точки и выберите %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Разрешить доступ к настройкам</string>
    <string name="copy_sheet_action">Открыть Настройки</string>

    <string name="open_sheet_title">Очистка открываемых ссылок</string>
    <string name="open_sheet_what">Сделайте Bugged браузером по умолчанию и выберите браузер, в котором будут открываться очищенные ссылки. Bugged очищает каждую ссылку, на которую вы нажимаете, и передаёт её дальше.</string>
    <string name="open_sheet_never">Bugged никогда не загружает страницу сам.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Очищенные ссылки открываются в %1$s</string>
    <string name="open_sheet_action">Сделать по умолчанию</string>
    <string name="browser_none">Браузеры не найдены</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Выберите браузер</string>

    <string name="about">О приложении</string>
    <string name="about_version">Версия приложения</string>
    <string name="about_rate">Оценить в Google Play</string>
    <string name="about_feedback">Отзывы и идеи</string>
    <string name="about_feedback_note">Сообщите об ошибке или предложите новую функцию. Я читаю каждое письмо.</string>
    <string name="about_feedback_subject">Отзывы и идеи</string>
    <string name="about_author">Задизайнил и разработал @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Скопировать данные о приложении и устройстве</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Скопировано</string>
    <string name="privacy_policy">Политика конфиденциальности</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Удаляет метки отслеживания из скопированных ссылок</string>
    <string name="service_description">Замечает, когда вы копируете ссылку, и удаляет из неё метки отслеживания. Чтобы заметить копирование, смотрит на нажатые кнопки «Копировать» и на предпросмотр буфера обмена. Bugged ничего не сохраняет из увиденного и не имеет доступа к интернету.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Очищенная ссылка</string>
</resources>
