<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Sluiten</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Terug</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">Aan</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Uit</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Aanzetten</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Uitzetten</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Aanzetten: %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Uitzetten: %1$s</string>
    <string name="not_now">Niet nu</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Wijzigen</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Browser wijzigen</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Schoon je links op</string>
    <string name="welcome_body">Veel links bevatten een tracker die sites vertelt wie de link heeft gedeeld en waarop je hebt getikt. Bugged beschermt je privacy door die tracker eraf te halen. De link opent dezelfde pagina.</string>
    <string name="welcome_offline">Werkt offline. Bugged heeft geen internettoegang, dus niets verlaat je telefoon.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged heeft Toegankelijkheid nodig om links die je kopieert te herkennen en op te schonen.</string>
    <string name="welcome_action">Instellen</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Kies wat je wilt opschonen</string>
    <string name="home_copy">Links die je kopieert worden opgeschoond</string>
    <string name="home_open">Links die je opent worden opgeschoond</string>
    <string name="home_both">Links die je kopieert en opent worden opgeschoond</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s link opgeschoond</item>
        <item quantity="other">%1$s links opgeschoond</item>
    </plurals>

    <string name="copy_title">Links die je kopieert</string>
    <string name="copy_description">Kopieer in elke app een link en plak hem opgeschoond.</string>
    <string name="open_title">Links die je opent</string>
    <string name="open_description">Tik in elke app op een link en hij opent opgeschoond in je browser.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Opent in %1$s</string>

    <string name="copy_sheet_title">Links die je kopieert opschonen</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged gebruikt Toegankelijkheid om links die je kopieert te herkennen, zodat de app ze kan opschonen als er een tracker in zit.</string>
    <string name="copy_sheet_access">De app kijkt alleen naar kopieerknoppen waarop je tikt en naar de tekst die je kopieert. De app leest nooit iets anders op je scherm.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">Tik in Instellingen op %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Zet %1$s aan</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">%1$s gebruiken</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Als Instellingen “Beperkte instelling” toont, open je de App-info van Bugged, tik je op de 3 puntjes en dan op %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Beperkte instellingen toestaan</string>
    <string name="copy_sheet_action">Instellingen openen</string>

    <string name="open_sheet_title">Links die je opent opschonen</string>
    <string name="open_sheet_what">Maak Bugged je standaard browser-app en kies de browser die de opgeschoonde links opent. Bugged schoont elke link op waarop je tikt en geeft hem door.</string>
    <string name="open_sheet_never">Bugged laadt de pagina nooit zelf.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Opgeschoonde links openen in %1$s</string>
    <string name="open_sheet_action">Standaard instellen</string>
    <string name="browser_none">Geen browser gevonden</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Browser kiezen</string>

    <string name="about">Over</string>
    <string name="about_version">App-versie</string>
    <string name="about_rate">Beoordelen op Google Play</string>
    <string name="about_feedback">Feedback en ideeën</string>
    <string name="about_feedback_note">Meld een bug of stel een functie voor. Ik lees elke e-mail.</string>
    <string name="about_feedback_subject">Feedback en ideeën</string>
    <string name="about_author">Ontworpen en ontwikkeld door @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">App- en apparaatinformatie kopiëren</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Gekopieerd</string>
    <string name="privacy_policy">Privacybeleid</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Verwijdert trackers uit gekopieerde links</string>
    <string name="service_description">Merkt op wanneer je een link kopieert en verwijdert de trackers eruit. Om een kopie op te merken, let de service op kopieerknoppen waarop je tikt en op het klembordvoorbeeld. Bugged bewaart niets van wat het ziet en heeft geen internettoegang.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Opgeschoonde link</string>
</resources>
