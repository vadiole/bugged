<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Chiudi</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Indietro</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">On</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Off</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Attiva</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Disattiva</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Attiva %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Disattiva %1$s</string>
    <string name="not_now">Non ora</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Cambia</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Cambia browser</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Pulisci i tuoi link</string>
    <string name="welcome_body">Molti link contengono un tracker che dice ai siti chi li ha condivisi e cosa hai toccato. Bugged protegge la tua privacy eliminandolo. Il link apre la stessa pagina.</string>
    <string name="welcome_offline">Funziona offline. Bugged non ha accesso a internet, quindi nulla esce dal tuo telefono.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged ha bisogno di Accessibilità per rilevare e pulire i link che copi.</string>
    <string name="welcome_action">Configura</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Scegli cosa pulire</string>
    <string name="home_copy">Pulizia dei link che copi</string>
    <string name="home_open">Pulizia dei link che apri</string>
    <string name="home_both">Pulizia dei link che copi e apri</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s link pulito</item>
        <item quantity="many">%1$s di link puliti</item>
        <item quantity="other">%1$s link puliti</item>
    </plurals>

    <string name="copy_title">Link che copi</string>
    <string name="copy_description">Copia un link in qualsiasi app e incollalo pulito.</string>
    <string name="open_title">Link che apri</string>
    <string name="open_description">Tocca un link in qualsiasi app e si apre pulito nel tuo browser.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Si apre in %1$s</string>

    <string name="copy_sheet_title">Pulisci i link che copi</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged usa Accessibilità per rilevare i link che copi, così può pulirli quando contengono un tracker.</string>
    <string name="copy_sheet_access">L’app guarda solo i pulsanti Copia che tocchi e il testo che copi. Non legge mai nient’altro sullo schermo.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">Nelle Impostazioni, tocca %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Attiva %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Usa %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Se nelle Impostazioni compare “Impostazioni con limitazioni”, apri Informazioni app di Bugged, tocca i tre puntini e poi %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Consenti impostazioni con limitazioni</string>
    <string name="copy_sheet_action">Apri Impostazioni</string>

    <string name="open_sheet_title">Pulisci i link che apri</string>
    <string name="open_sheet_what">Imposta Bugged come app browser predefinita e scegli il browser che apre i link puliti. Bugged pulisce ogni link che tocchi e lo inoltra.</string>
    <string name="open_sheet_never">Bugged non carica mai la pagina direttamente.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">I link puliti si aprono in %1$s</string>
    <string name="open_sheet_action">Imposta come predefinita</string>
    <string name="browser_none">Nessun browser trovato</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Scegli un browser</string>

    <string name="about">Informazioni</string>
    <string name="about_version">Versione app</string>
    <string name="about_rate">Valuta su Google Play</string>
    <string name="about_feedback">Feedback e idee</string>
    <string name="about_feedback_note">Segnala un bug o suggerisci una funzione. Leggo ogni email.</string>
    <string name="about_feedback_subject">Feedback e idee</string>
    <string name="about_author">Progettato e sviluppato da @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Copia le informazioni su app e dispositivo</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Copiato</string>
    <string name="privacy_policy">Informativa sulla privacy</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Rimuove i tracker dai link copiati</string>
    <string name="service_description">Si accorge quando copi un link e ne rimuove i tracker. Per accorgersi di una copia, osserva i pulsanti Copia che tocchi e l’anteprima degli appunti. Bugged non conserva nulla di ciò che vede e non ha accesso a internet.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Link pulito</string>
</resources>
