<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">დახურვა</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">უკან</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">ჩართული</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">გამორთული</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">ჩართვა</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">გამორთვა</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">ჩართვა: %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">გამორთვა: %1$s</string>
    <string name="not_now">ახლა არა</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">შეცვლა</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">ბრაუზერის შეცვლა</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">გაასუფთავეთ ბმულები</string>
    <string name="welcome_body">ბევრ ბმულს თვალთვალის ტეგი ახლავს, რომელიც საიტებს ატყობინებს, ვინ გააზიარა ბმული და რას შეეხეთ. Bugged ამ ტეგს შლის და ასე იცავს თქვენს კონფიდენციალურობას. ბმული იმავე გვერდს ხსნის.</string>
    <string name="welcome_offline">მუშაობს ინტერნეტის გარეშე. Bugged-ს ინტერნეტზე წვდომა არ აქვს, ამიტომ თქვენი ტელეფონიდან არაფერი გადის.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged-ს სჭირდება „მარტივი წვდომა“, რომ კოპირებული ბმულები ამოიცნოს და გაასუფთაოს.</string>
    <string name="welcome_action">დაყენება</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">აირჩიეთ, რა გასუფთავდეს</string>
    <string name="home_copy">კოპირებული ბმულები სუფთავდება</string>
    <string name="home_open">გახსნილი ბმულები სუფთავდება</string>
    <string name="home_both">კოპირებული და გახსნილი ბმულები სუფთავდება</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s ბმული გასუფთავდა</item>
        <item quantity="other">%1$s ბმული გასუფთავდა</item>
    </plurals>

    <string name="copy_title">კოპირებული ბმულები</string>
    <string name="copy_description">დააკოპირეთ ბმული ნებისმიერ აპში და ჩასვით სუფთა სახით.</string>
    <string name="open_title">გახსნილი ბმულები</string>
    <string name="open_description">შეეხეთ ბმულს ნებისმიერ აპში და ის თქვენს ბრაუზერში სუფთა სახით გაიხსნება.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">იხსნება ბრაუზერში %1$s</string>

    <string name="copy_sheet_title">კოპირებული ბმულების გასუფთავება</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged ფუნქციით „მარტივი წვდომა“ ამოიცნობს კოპირებულ ბმულებს, რომ გაასუფთაოს ისინი, თუ მათში თვალთვალის ტეგია.</string>
    <string name="copy_sheet_access">აპი მხოლოდ იმ კოპირების ღილაკებს აკვირდება, რომლებსაც შეეხებით, და ტექსტს, რომელსაც აკოპირებთ. ეკრანზე სხვა არაფერს არასდროს კითხულობს.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">პარამეტრებში აირჩიეთ %1$s</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">ჩართეთ %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">%1$s-ის გამოყენება</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">თუ პარამეტრებში გამოჩნდება „შეზღუდული რეჟიმის პარამეტრები“, გახსენით Bugged-ის „აპის მონაცემები“, შეეხეთ 3 წერტილს და აირჩიეთ %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">შეზღუდული რეჟიმის პარამეტრების დაშვება</string>
    <string name="copy_sheet_action">პარამეტრების გახსნა</string>

    <string name="open_sheet_title">გახსნილი ბმულების გასუფთავება</string>
    <string name="open_sheet_what">დააყენეთ Bugged ნაგულისხმევი ბრაუზერის აპად და აირჩიეთ ბრაუზერი, რომელშიც სუფთა ბმულები გაიხსნება. Bugged ასუფთავებს ყველა ბმულს, რომელსაც შეეხებით, და მას ამ ბრაუზერს გადასცემს.</string>
    <string name="open_sheet_never">Bugged თავად გვერდს არასდროს ტვირთავს.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">სუფთა ბმულები იხსნება ბრაუზერში %1$s</string>
    <string name="open_sheet_action">ნაგულისხმევად დაყენება</string>
    <string name="browser_none">ბრაუზერი ვერ მოიძებნა</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">ბრაუზერის არჩევა</string>

    <string name="about">აპის შესახებ</string>
    <string name="about_version">აპის ვერსია</string>
    <string name="about_rate">შეაფასეთ Google Play-ზე</string>
    <string name="about_feedback">უკუკავშირი და იდეები</string>
    <string name="about_feedback_note">შემატყობინეთ ხარვეზის შესახებ ან შემომთავაზეთ ახალი ფუნქცია. ყველა წერილს ვკითხულობ.</string>
    <string name="about_feedback_subject">უკუკავშირი და იდეები</string>
    <string name="about_author">დიზაინი და შემუშავება: @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">აპისა და მოწყობილობის ინფორმაციის კოპირება</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">დაკოპირდა</string>
    <string name="privacy_policy">კონფიდენციალურობის პოლიტიკა</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">შლის თვალთვალის ტეგებს კოპირებული ბმულებიდან</string>
    <string name="service_description">ამჩნევს, როცა ბმულს აკოპირებთ, და მისგან თვალთვალის ტეგებს შლის. კოპირების შესამჩნევად აკვირდება იმ კოპირების ღილაკებს, რომლებსაც შეეხებით, და ბუფერის გადახედვის ფანჯარას. Bugged არაფერს ინახავს იმისგან, რასაც ხედავს, და ინტერნეტზე წვდომა არ აქვს.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">სუფთა ბმული</string>
</resources>
