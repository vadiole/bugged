<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Stäng</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Tillbaka</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">På</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Av</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Slå på</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Stäng av</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Slå på %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Stäng av %1$s</string>
    <string name="not_now">Inte nu</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Byt</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Byt webbläsare</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Rensa dina länkar</string>
    <string name="welcome_body">Många länkar innehåller en spårare som talar om för webbplatser vem som delade dem och vad du tryckte på. Bugged skyddar din integritet genom att klippa bort den. Länken leder till samma sida.</string>
    <string name="welcome_offline">Fungerar offline. Bugged har ingen internetåtkomst, så inget lämnar telefonen.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged behöver Tillgänglighet för att hitta och rensa länkar som du kopierar.</string>
    <string name="welcome_action">Ställ in</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Välj vad som ska rensas</string>
    <string name="home_copy">Rensar länkar som du kopierar</string>
    <string name="home_open">Rensar länkar som du öppnar</string>
    <string name="home_both">Rensar länkar som du kopierar och öppnar</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s länk rensad</item>
        <item quantity="other">%1$s länkar rensade</item>
    </plurals>

    <string name="copy_title">Länkar du kopierar</string>
    <string name="copy_description">Kopiera en länk i vilken app som helst och klistra in den rensad.</string>
    <string name="open_title">Länkar du öppnar</string>
    <string name="open_description">Tryck på en länk i vilken app som helst så öppnas den rensad i webbläsaren.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Öppnas i %1$s</string>

    <string name="copy_sheet_title">Rensa länkar som du kopierar</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged använder Tillgänglighet för att hitta länkar som du kopierar, så att de kan rensas när de innehåller en spårare.</string>
    <string name="copy_sheet_access">Appen tittar bara på Kopiera-knappar som du trycker på och texten som du kopierar. Den läser aldrig något annat på skärmen.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">Tryck på %1$s i Inställningar</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Slå på %1$s</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Använd %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Om Inställningar visar ”Blockerad inställning” öppnar du Appinformation för Bugged, trycker på de tre punkterna och sedan på %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Tillåt blockerade inställningar</string>
    <string name="copy_sheet_action">Öppna Inställningar</string>

    <string name="open_sheet_title">Rensa länkar som du öppnar</string>
    <string name="open_sheet_what">Gör Bugged till din standardwebbläsarapp och välj vilken webbläsare som ska öppna de rensade länkarna. Bugged rensar varje länk som du trycker på och skickar den vidare.</string>
    <string name="open_sheet_never">Bugged läser aldrig in sidan själv.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Rensade länkar öppnas i %1$s</string>
    <string name="open_sheet_action">Ange som standard</string>
    <string name="browser_none">Ingen webbläsare hittades</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Välj en webbläsare</string>

    <string name="about">Om</string>
    <string name="about_version">Appversion</string>
    <string name="about_rate">Betygsätt på Google Play</string>
    <string name="about_feedback">Feedback och idéer</string>
    <string name="about_feedback_note">Rapportera en bugg eller föreslå en funktion. Jag läser varje mejl.</string>
    <string name="about_feedback_subject">Feedback och idéer</string>
    <string name="about_author">Designad och utvecklad av @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Kopiera app- och enhetsinformation</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Kopierat</string>
    <string name="privacy_policy">Integritetspolicy</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Tar bort spårare från kopierade länkar</string>
    <string name="service_description">Märker när du kopierar en länk och tar bort spårarna. För att märka en kopiering letar appen efter Kopiera-knappar som du trycker på och förhandsvisningen av urklipp. Bugged sparar inget av det den ser och har ingen internetåtkomst.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Rensad länk</string>
</resources>
