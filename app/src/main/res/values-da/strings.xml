<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the dimmed area behind a bottom sheet. Tapping it closes the sheet. -->
    <string name="close">Luk</string>
    <!-- Accessibility label of the back arrow in the top bar. -->
    <string name="back">Tilbage</string>
    <!-- Status label on a feature card: the feature is on. -->
    <string name="on">Til</string>
    <!-- Status label on a feature card: the feature is off. -->
    <string name="off">Fra</string>
    <!-- Button on a feature card. -->
    <string name="turn_on">Slå til</string>
    <!-- Button on a feature card. -->
    <string name="turn_off">Slå fra</string>
    <!-- Screen reader label of the "Turn on" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_on_feature">Slå til: %1$s</string>
    <!-- Screen reader label of the "Turn off" button. %1$s is the feature, "Links you copy" or "Links you open". -->
    <string name="turn_off_feature">Slå fra: %1$s</string>
    <string name="not_now">Ikke nu</string>
    <!-- Button that opens a list of browsers to pick from. -->
    <string name="change">Skift</string>
    <!-- Screen reader label of the "Change" button. -->
    <string name="change_browser">Skift browser</string>

    <!-- First screen. Headline, also the app's slogan. -->
    <string name="welcome_title">Rens dine links</string>
    <string name="welcome_body">Mange links indeholder en sporingskode, der fortæller websites, hvem der delte dem, og hvad du trykkede på. Bugged beskytter dit privatliv ved at fjerne den. Linket åbner stadig den samme side.</string>
    <string name="welcome_offline">Virker offline. Bugged har ingen internetadgang, så intet forlader din telefon.</string>
    <!-- "Accessibility" is the name of the Android settings section. Use the name Android uses in this language. -->
    <string name="welcome_access">Bugged skal bruge Hjælpefunktioner til at registrere og rense links, du kopierer.</string>
    <string name="welcome_action">Konfigurer</string>

    <!-- Home headline while both features are off. -->
    <string name="home_choose">Vælg, hvad der skal renses</string>
    <string name="home_copy">Renser links, du kopierer</string>
    <string name="home_open">Renser links, du åbner</string>
    <string name="home_both">Renser links, du kopierer og åbner</string>
    <!-- Home headline. %1$s is the formatted number of links cleaned so far, like 1,280. -->
    <plurals name="home_cleaned">
        <item quantity="one">%1$s link renset</item>
        <item quantity="other">%1$s links renset</item>
    </plurals>

    <string name="copy_title">Links, du kopierer</string>
    <string name="copy_description">Kopiér et link i en hvilken som helst app, og indsæt det renset.</string>
    <string name="open_title">Links, du åbner</string>
    <string name="open_description">Tryk på et link i en hvilken som helst app, så åbner det renset i din browser.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_browser">Åbner i %1$s</string>

    <string name="copy_sheet_title">Rens links, du kopierer</string>
    <!-- "Accessibility" is the name of the Android settings section. -->
    <string name="copy_sheet_what">Bugged bruger Hjælpefunktioner til at registrere links, du kopierer, så de kan renses, når de indeholder en sporingskode.</string>
    <string name="copy_sheet_access">Appen ser kun på de Kopiér-knapper, du trykker på, og den tekst, du kopierer. Den læser aldrig noget andet på din skærm.</string>
    <!-- Step 1. "Settings" is the Android Settings app. %1$s is the app name, Bugged. -->
    <string name="copy_sheet_step_1">Tryk på %1$s i Indstillinger</string>
    <!-- Step 2. %1$s is the label of the switch in Android's Accessibility settings, "Use Bugged". -->
    <string name="copy_sheet_step_2">Slå %1$s til</string>
    <!-- Label of the switch in Android's Accessibility settings. Use Android's own wording in this language. %1$s is the app name. -->
    <string name="copy_sheet_switch">Brug %1$s</string>
    <!-- “Restricted setting” is the title of an Android dialog, "App info" is an Android settings screen. %1$s is the menu item "Allow restricted settings". Use Android's own wording in this language. -->
    <string name="copy_sheet_restricted">Hvis Indstillinger viser “Begrænset indstilling”, skal du åbne Appinfo for Bugged, trykke på de 3 prikker og derefter på %1$s.</string>
    <!-- Menu item on Android's App info screen. Use Android's own wording in this language. -->
    <string name="copy_sheet_allow">Tillad begrænsede indstillinger</string>
    <string name="copy_sheet_action">Åbn Indstillinger</string>

    <string name="open_sheet_title">Rens links, du åbner</string>
    <string name="open_sheet_what">Gør Bugged til din standardapp til browsing, og vælg den browser, der skal åbne de rensede links. Bugged renser hvert link, du trykker på, og sender det videre.</string>
    <string name="open_sheet_never">Bugged indlæser aldrig selve siden.</string>
    <!-- %1$s is a browser name, like Chrome. -->
    <string name="open_sheet_browser">Rensede links åbnes i %1$s</string>
    <string name="open_sheet_action">Angiv som standard</string>
    <string name="browser_none">Ingen browser fundet</string>
    <!-- Title of the list of installed browsers. -->
    <string name="browser_title">Vælg en browser</string>

    <string name="about">Om</string>
    <string name="about_version">Appversion</string>
    <string name="about_rate">Bedøm på Google Play</string>
    <string name="about_feedback">Feedback og idéer</string>
    <string name="about_feedback_note">Rapportér en fejl, eller foreslå en funktion. Jeg læser hver eneste e-mail.</string>
    <string name="about_feedback_subject">Feedback og idéer</string>
    <string name="about_author">Designet og udviklet af @vadiole</string>
    <!-- Accessibility action on the version row. -->
    <string name="about_copy">Kopiér app- og enhedsoplysninger</string>
    <!-- Short message after the app and device info was copied. -->
    <string name="about_copied">Kopieret</string>
    <string name="privacy_policy">Privatlivspolitik</string>

    <!-- Shown by Android in Accessibility settings, under the app name. -->
    <string name="service_summary">Fjerner sporingskoder fra kopierede links</string>
    <string name="service_description">Registrerer, når du kopierer et link, og fjerner dets sporingskoder. For at registrere det holder den øje med Kopiér-knapper, du trykker på, og forhåndsvisningen af udklipsholderen. Bugged gemmer intet af det, den ser, og har ingen internetadgang.</string>
    <!-- Label Android may show for the cleaned clipboard content. -->
    <string name="clip_label">Renset link</string>
</resources>
